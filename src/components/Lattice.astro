---
/**
 * The 6×6×6 lattice as an ambient section background (visual.animated-patterns).
 * Purely decorative — aria-hidden, and it never sits under body text without a
 * stable surface behind that text (rule motion.bg-contrast).
 */
interface Props { class?: string; intensity?: 'low' | 'high' }
const { class: cls = '', intensity = 'low' } = Astro.props;

const cols = 24;
const rows = 14;
const cells: { x: number; y: number; lit: boolean; i: number }[] = [];
for (let r = 0; r < rows; r++) {
  for (let c = 0; c < cols; c++) {
    const i = r * cols + c;
    cells.push({ x: c * 40 + 20, y: r * 40 + 20, lit: (i * 7) % 29 === 0, i });
  }
}
---
<div class={`lattice lattice--${intensity} ${cls}`} aria-hidden="true">
  <svg viewBox={`0 0 ${cols * 40} ${rows * 40}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" role="presentation">
    {cells.map((c) => (
      <rect
        x={c.x - 1.5} y={c.y - 1.5} width="3" height="3" rx="0.5"
        fill={c.lit ? '#3F6EE9' : '#F5F7FA'}
        class={c.lit ? `lattice__lit lattice__d${c.i % 8}` : 'lattice__dot'}
      />
    ))}
  </svg>
</div>

<style>
  .lattice {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    mask-image: radial-gradient(115% 85% at 50% 0%, #000 5%, transparent 72%);
  }
  .lattice svg { width: 100%; height: 100%; }
  .lattice--low { opacity: 0.35; }
  .lattice--high { opacity: 0.6; }

  .lattice__dot { opacity: 0.09; }
  .lattice__lit {
    opacity: 0.2;
    animation: lat-pulse 6s var(--ease-out) infinite;
  }
  /* Stagger comes from eight delay buckets rather than a per-node inline
     style — 900 inline style attributes bypass the token layer. */
  .lattice__d0 { animation-delay: 0ms; }
  .lattice__d1 { animation-delay: 260ms; }
  .lattice__d2 { animation-delay: 520ms; }
  .lattice__d3 { animation-delay: 780ms; }
  .lattice__d4 { animation-delay: 1040ms; }
  .lattice__d5 { animation-delay: 1300ms; }
  .lattice__d6 { animation-delay: 1560ms; }
  .lattice__d7 { animation-delay: 1820ms; }
  @keyframes lat-pulse {
    0%, 100% { opacity: 0.16; }
    50% { opacity: 0.85; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lattice__lit { animation: none; opacity: 0.4; }
  }
</style>
