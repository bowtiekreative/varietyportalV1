---
import { SITE, BRAND } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Per-route metadata — never duplicated across routes. */
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, noindex = false, jsonLd } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

/* Every indexable route carries structured data describing content that is
   actually visible on the page (rule seo.markup-visible). */
const base: Record<string, unknown>[] = noindex
  ? []
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: title,
        description,
        url: canonical,
        isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
        inLanguage: 'en',
      },
      ...(path === '/'
        ? []
        : [
            {
              '@context': 'https://schema.org',
              '@type': 'BreadcrumbList',
              itemListElement: [
                { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
                { '@type': 'ListItem', position: 2, name: title, item: canonical },
              ],
            },
          ]),
    ];

const blocks = [...base, ...extra];
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content="https://media.publit.io/file/SEO-thumbnails/varietyportal-com.png" />
<meta property="og:image:width" content="1280" />
<meta property="og:image:height" content="720" />
<meta property="og:image:type" content="image/png" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content="https://media.publit.io/file/SEO-thumbnails/varietyportal-com.png" />

{blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
