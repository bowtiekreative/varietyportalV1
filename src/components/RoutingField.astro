---
/**
 * The hero's visual anchor (rules visual.no-dull, visual.animated-patterns).
 * One symptom fans into many candidate paths; the poor fits fade; one route
 * resolves. The motion states the thesis before the copy does.
 *
 * Reduced motion: the animation is suppressed and the resolved path is drawn
 * statically, so the meaning survives without movement (rule motion.reduced).
 */

const W = 760;
const H = 520;

const originX = 74;
const originY = H / 2;
const targetX = W - 74;
const targetY = H / 2;

// Deterministic fan of candidate paths — no randomness, so the frames are stable.
const COUNT = 22;
const candidates = Array.from({ length: COUNT }, (_, i) => {
  const t = COUNT === 1 ? 0.5 : i / (COUNT - 1);
  const spread = (t - 0.5) * 2;                    // -1 … 1
  const midY = originY + spread * (H / 2 - 46);
  const c1x = originX + 190;
  const c2x = targetX - 190;
  const endY = originY + spread * 34;
  return {
    d: `M ${originX} ${originY} C ${c1x} ${originY + spread * 24}, ${c2x} ${midY}, ${targetX} ${endY}`,
    dim: 0.1 + (1 - Math.abs(spread)) * 0.12,
  };
});

// The one path that survives elimination.
const resolved = `M ${originX} ${originY} C ${originX + 190} ${originY - 6}, ${targetX - 210} ${originY - 96}, ${targetX} ${targetY}`;

// 216 lattice behind the fan: 18 x 12.
const cols = 18;
const rows = 12;
const dots: { x: number; y: number; o: number }[] = [];
for (let r = 0; r < rows; r++) {
  for (let c = 0; c < cols; c++) {
    const x = 40 + (c * (W - 80)) / (cols - 1);
    const y = 40 + (r * (H - 80)) / (rows - 1);
    const dx = (x - W / 2) / (W / 2);
    const dy = (y - H / 2) / (H / 2);
    dots.push({ x, y, o: Math.max(0.05, 0.3 - Math.hypot(dx, dy) * 0.2) });
  }
}
---
<div class="field" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} class="field__svg" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false" role="presentation">
    <defs>
      <linearGradient id="rf-live" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#3F6EE9" stop-opacity="0" />
        <stop offset="45%" stop-color="#5A83EE" stop-opacity="1" />
        <stop offset="100%" stop-color="#8AA6F2" stop-opacity="0.9" />
      </linearGradient>
      <radialGradient id="rf-glow">
        <stop offset="0%" stop-color="#3F6EE9" stop-opacity="0.5" />
        <stop offset="100%" stop-color="#3F6EE9" stop-opacity="0" />
      </radialGradient>
      <filter id="rf-soft" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="7" />
      </filter>
    </defs>

    <!-- the 216 possibility lattice -->
    <g class="field__lattice">
      {dots.map((p, i) => (
        <circle cx={p.x} cy={p.y} r="1.5" fill="#F5F7FA" opacity={p.o} class={`field__dot field__b${i % 6}`} />
      ))}
    </g>

    <!-- candidate paths -->
    <g fill="none" stroke-linecap="round">
      {candidates.map((p, i) => (
        <path d={p.d} stroke="#8AA6F2" stroke-width="1" opacity={p.dim} class={`field__candidate field__c${i % 6}`} />
      ))}
    </g>

    <!-- eliminated-to-resolved route -->
    <ellipse cx={targetX} cy={targetY} rx="120" ry="120" fill="url(#rf-glow)" filter="url(#rf-soft)" class="field__glow" />
    <path d={resolved} fill="none" stroke="#1A1D24" stroke-width="6" />
    <path d={resolved} fill="none" stroke="url(#rf-live)" stroke-width="2.5" class="field__resolved" stroke-linecap="round" />

    <!-- endpoints -->
    <g class="field__node">
      <circle cx={originX} cy={originY} r="26" fill="#0B0E14" stroke="rgba(245,247,250,0.15)" />
      <circle cx={originX} cy={originY} r="6" fill="#8AA6F2" />
      <circle cx={originX} cy={originY} r="26" fill="none" stroke="#3F6EE9" stroke-width="1.5" class="field__ping" />
    </g>
    <g class="field__node">
      <circle cx={targetX} cy={targetY} r="30" fill="#0B0E14" stroke="#3F6EE9" stroke-width="1.5" />
      <path
        d={`M ${targetX - 9} ${targetY} l 6 6 l 12 -13`}
        fill="none"
        stroke="#8AA6F2"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="field__tick"
      />
    </g>
  </svg>

  <p class="field__legend micro">
    <span class="field__key field__key--many"></span>216 candidate paths
    <span class="field__key field__key--one"></span>one recommended move
  </p>
</div>

<style>
  .field { position: relative; width: 100%; }
  .field__svg { width: 100%; height: auto; overflow: visible; }

  .field__lattice circle { animation: rf-breathe 7s var(--ease-out) infinite; }
  .field__b0 { animation-delay: 0ms; }
  .field__b1 { animation-delay: 400ms; }
  .field__b2 { animation-delay: 800ms; }
  .field__b3 { animation-delay: 1200ms; }
  .field__b4 { animation-delay: 1600ms; }
  .field__b5 { animation-delay: 2000ms; }
  @keyframes rf-breathe { 0%, 100% { opacity: inherit; } 50% { opacity: 0.42; } }

  .field__candidate {
    stroke-dasharray: 4 7;
    animation: rf-drift 5.5s linear infinite;
  }
  .field__c0 { animation-delay: 0ms; }
  .field__c1 { animation-delay: 250ms; }
  .field__c2 { animation-delay: 500ms; }
  .field__c3 { animation-delay: 750ms; }
  .field__c4 { animation-delay: 1000ms; }
  .field__c5 { animation-delay: 1250ms; }
  @keyframes rf-drift { to { stroke-dashoffset: -110; } }

  .field__resolved {
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    animation: rf-draw 3.4s var(--ease-out) 0.4s forwards;
  }
  @keyframes rf-draw { to { stroke-dashoffset: 0; } }

  .field__glow { opacity: 0; animation: rf-fade 1.6s var(--ease-out) 3s forwards; }
  .field__tick { stroke-dasharray: 30; stroke-dashoffset: 30; animation: rf-draw 700ms var(--ease-out) 3.4s forwards; }
  @keyframes rf-fade { to { opacity: 1; } }

  .field__ping { transform-origin: 74px 260px; animation: rf-ping 3.6s var(--ease-out) infinite; }
  @keyframes rf-ping {
    0% { transform: scale(1); opacity: 0.7; }
    70%, 100% { transform: scale(1.9); opacity: 0; }
  }

  .field__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
    justify-content: center;
  }
  .field__key { width: 22px; height: 2px; border-radius: 2px; display: inline-block; margin-right: var(--space-1); }
  .field__key--many { background: #8AA6F2; opacity: 0.4; }
  .field__key--one { background: #5A83EE; }

  /* Reduced motion: no drift, no draw-on — the resolved route is simply there. */
  @media (prefers-reduced-motion: reduce) {
    .field__lattice circle,
    .field__candidate,
    .field__dot,
    .field__ping { animation: none; }
    .field__resolved { stroke-dashoffset: 0; animation: none; }
    .field__glow { opacity: 1; animation: none; }
    .field__tick { stroke-dashoffset: 0; animation: none; }
  }
</style>
