# Public — inlined into the client bundle at BUILD time.
PUBLIC_SITE_URL=https://varietyportal.com
# Leave blank until a real GA4 property exists. A blank value loads no tag at all.
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_CONTACT_EMAIL=hello@varietyportal.com
# Optional external scheduler. Blank = the on-site booking request form is used.
PUBLIC_BOOKING_URL=

# Server-only — never inlined into the bundle.
MONGO_URL=mongodb://vp-mongo:27017
MONGO_DB=varietyportal

EMAILIT_URL=https://api.emailit.com/v2/
EMAILIT_API_KEY=
# The FROM domain must be VERIFIED in Emailit. varietyportal.com is not yet
# verified there; bowtiekreative.com is (SPF + DKIM ok since 2024). Switch this
# to routing@varietyportal.com only after adding and verifying that domain.
EMAIL_FROM=Variety Portal <routing@bowtiekreative.com>
EMAIL_INTERNAL_TO=ryan@bowtiekreative.com

# Shared secret for POST /api/nurture. Without it the endpoint refuses to run.
CRON_SECRET=
